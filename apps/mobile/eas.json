{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divvy.mooo.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divvy.mooo.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "597758345543-juuqoo27cqi9t58cnhupi6h2jej8hu3o.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "597758345543-p0up3ub89kntintmefi4mjjr25kfc3bi.apps.googleusercontent.com",
        "EXPO_PUBLIC_APPLE_WEB_SERVICES_ID": "app.divvy.ledger.web",
        "EXPO_PUBLIC_APPLE_WEB_REDIRECT_URI": "https://divvy.mooo.com/app/auth/apple"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divvy.mooo.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "597758345543-juuqoo27cqi9t58cnhupi6h2jej8hu3o.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "597758345543-p0up3ub89kntintmefi4mjjr25kfc3bi.apps.googleusercontent.com",
        "EXPO_PUBLIC_APPLE_WEB_SERVICES_ID": "app.divvy.ledger.web",
        "EXPO_PUBLIC_APPLE_WEB_REDIRECT_URI": "https://divvy.mooo.com/app/auth/apple"
      },
      "android": {
        "autoIncrement": true
      }
    },
    "production-ios": {
      "extends": "production",
      "credentialsSource": "local",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5E845TX3E6",
        "ascAppId": "6828637709"
      }
    }
  }
