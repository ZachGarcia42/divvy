{
  "expo": {
    "name": "Divvy",
    "slug": "divvy",
    "scheme": "divvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.divvy.ledger"
    },
    "android": {
      "package": "app.divvy.ledger",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0f766e"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Divvy uses your photos so you can attach a receipt to an expense.",
          "cameraPermission": "Divvy uses the camera so you can photograph a receipt for an expense.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "divvy-zag",
    "extra": {
      "eas": {
        "projectId": "3568ac6b-d831-42df-bcb3-3056c17a6f37"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    }
  }
}
