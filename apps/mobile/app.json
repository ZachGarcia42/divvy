{
  "expo": {
    "name": "Divvy",
    "slug": "divvy",
    "scheme": "divvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.divvy.ledger"
    },
    "android": {
      "package": "app.divvy.ledger",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0f766e"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "owner": "divvy-zag",
    "extra": {
      "eas": {
        "projectId": "3568ac6b-d831-42df-bcb3-3056c17a6f37"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    }
  }
}
